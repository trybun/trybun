# Environment of Trybun (§15.3). Copy to `.env` for the local environment: `cp .env.example .env`.
# The same file configures Docker Compose (compose.yaml). The passwords below are development
# values; the install script generates random ones (§15.5). Use letters and digits only.

# Public domain of the installation, without scheme (e.g. trybun.example.com). Required.
TRYBUN_DOMAIN=localhost

# Port of the API process. Default: 3001.
TRYBUN_API_PORT=3001

# Internal address of the API used by the web application. Required.
TRYBUN_API_URL=http://localhost:3001

# PostgreSQL system database of the API, the Worker and the migrations (name defined by Prisma).
# Required. Compose sets it for the containers.
DATABASE_URL=postgresql://trybun:trybun@localhost:5432/trybun

# Valkey of the queues (§14.2). Required. Compose sets it for the containers.
TRYBUN_VALKEY_URL=redis://:valkey@localhost:6379

# Default language of the system and of the Keycloak login screens: `en` or `pl` (§13.1). Users
# whose browser language is not supported and who have not chosen a language see it. Default: en.
# TRYBUN_DEFAULT_LANGUAGE=en

# Default time zone of the system (§13.1): an IANA name, e.g. Europe/Warsaw. Dates and times are
# shown in it until a user sets their own. Default: UTC.
# TRYBUN_DEFAULT_TIME_ZONE=UTC

# Level of the JSON logs of the API and the Worker (§17.2): fatal, error, warn, info, debug or
# silent. Default: info.
# TRYBUN_LOG_LEVEL=info

# --- Sign-in (§7.4, §14.4) ---

# Public URL of the web application, used by Auth.js for its callbacks (name defined by Auth.js 4).
# Required. Compose sets https://<TRYBUN_DOMAIN> for the container.
NEXTAUTH_URL=http://localhost:3000

# Secret of Auth.js: protects its cookies and encrypts the Keycloak tokens of the sessions. At
# least 32 characters. Required.
AUTH_SECRET=development-secret-of-at-least-32-characters

# Keycloak on the internal network (discovery, tokens, signing keys). Required. Compose sets it
# for the containers.
TRYBUN_KEYCLOAK_URL=http://localhost:8080/auth

# Public URL of Keycloak, the base of the token issuer. Default: https://<TRYBUN_DOMAIN>/auth.
# Only the local environment sets it; Compose never passes it to the containers.
TRYBUN_KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth

# Secrets of the Keycloak clients `trybun-web` (sign-in of the web application) and
# `trybun-server` (Admin API of the server). Required.
TRYBUN_KEYCLOAK_WEB_CLIENT_SECRET=web
TRYBUN_KEYCLOAK_SERVER_CLIENT_SECRET=server

# Sign-in providers, each shown on the login screen only when both its variables are set (§15.3):
# GitHub for team members, Microsoft and Google for end users. Applied by `keycloak-config`.
# TRYBUN_GITHUB_CLIENT_ID=
# TRYBUN_GITHUB_CLIENT_SECRET=
# TRYBUN_MICROSOFT_CLIENT_ID=
# TRYBUN_MICROSOFT_CLIENT_SECRET=
# TRYBUN_GOOGLE_CLIENT_ID=
# TRYBUN_GOOGLE_CLIENT_SECRET=

# --- E-mail ---

# Outgoing e-mail (SMTP), shared by the server and Keycloak (password reset, e-mail
# verification, §15.5). Without TRYBUN_SMTP_HOST no e-mail is sent. The local environment sends
# all e-mail to Mailpit (compose.dev.yaml). TRYBUN_SMTP_SECURITY: `starttls` (default), `tls` or
# `none`; TRYBUN_SMTP_PORT default: 587; TRYBUN_MAIL_FROM is required with TRYBUN_SMTP_HOST.
# TRYBUN_SMTP_HOST=
# TRYBUN_SMTP_PORT=587
# TRYBUN_SMTP_SECURITY=starttls
# TRYBUN_SMTP_USER=
# TRYBUN_SMTP_PASSWORD=
# TRYBUN_MAIL_FROM=

# Heartbeat file of the Worker, checked by its health check (§17.2). Default: in the system's
# temporary directory.
# TRYBUN_WORKER_HEARTBEAT_FILE=/tmp/trybun-worker.heartbeat

# --- Docker Compose ---

# Optional services: `seaweedfs` (remove when an external S3 storage is used), `clamav` (remove
# locally when memory is short; uploads then stay in quarantine).
COMPOSE_PROFILES=seaweedfs,clamav

# Version of the images ghcr.io/trybun/*. Default: the version of the deployment package; latest
# in the repository.
# TRYBUN_VERSION=latest

# Password of the PostgreSQL user `trybun` (system database). Required.
TRYBUN_POSTGRES_PASSWORD=trybun

# Password of the PostgreSQL user `keycloak` (Keycloak database). Required.
TRYBUN_KEYCLOAK_DB_PASSWORD=keycloak

# Password of the Keycloak administrator `admin`, used by keycloak-config-cli. Required.
TRYBUN_KEYCLOAK_ADMIN_PASSWORD=admin

# Password of Valkey. Required.
TRYBUN_VALKEY_PASSWORD=valkey

# Credentials of the S3 API of SeaweedFS. Required with the `seaweedfs` profile.
TRYBUN_S3_ACCESS_KEY_ID=trybun
TRYBUN_S3_SECRET_ACCESS_KEY=seaweedfs
