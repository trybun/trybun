# Environment of Trybun (§15.3). Copy to `.env` for the local environment: `cp .env.example .env`.

# Public domain of the installation, without scheme (e.g. trybun.example.com). Required.
TRYBUN_DOMAIN=localhost

# Port of the API process. Default: 3001.
TRYBUN_API_PORT=3001

# Internal address of the API used by the web application. Required.
TRYBUN_API_URL=http://localhost:3001
