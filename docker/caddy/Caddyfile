# The only public entry point (§14.4, §15.9): automatic HTTPS (§15.8) and routing by path.
{$TRYBUN_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Access logs without query strings and credentials (§15.9, §17.2).
	log {
		format filter {
			request>uri regexp \?.*$ ""
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
		}
	}

	# WebSocket gateway of the API.
	handle /socket.io/* {
		reverse_proxy api:3001
	}

	# Sign-in endpoints of Keycloak only; the administration console is never routed.
	@keycloak path /auth/realms/trybun/* /auth/resources/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}
	handle /auth/* {
		error 404
	}

	# Everything else, including the BFF endpoint /api/v1/* and the incoming webhooks.
	handle {
		reverse_proxy web:3000
	}
}
