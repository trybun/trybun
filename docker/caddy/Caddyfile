# The only public entry point (§14.4, §15.9): automatic HTTPS (§15.8) and routing by path.
# The security headers, HSTS included, are set by the web application (apps/web/src/proxy.ts) and
# by Keycloak for its own pages (§13.5).
{$TRYBUN_DOMAIN} {
	# Access logs without query strings and credentials (§15.9, §17.2).
	log {
		format filter {
			request>uri regexp \?.*$ ""
			request>headers>Authorization delete
			request>headers>Cookie delete
			resp_headers>Set-Cookie delete
		}
	}

	# WebSocket gateway of the API.
	handle /socket.io/* {
		reverse_proxy api:3001
	}

	# Sign-in endpoints of Keycloak only; the administration console is never routed.
	@keycloak path /auth/realms/trybun/* /auth/resources/*
	handle @keycloak {
		reverse_proxy keycloak:8080
	}
	handle /auth/* {
		error 404
	}

	# Back-channel logout is called by Keycloak over the internal network only (§14.4).
	handle /api/auth/backchannel-logout {
		error 404
	}

	# Everything else, including the BFF endpoint /api/v1/* and the incoming webhooks.
	handle {
		reverse_proxy web:3000
	}
}
