{
  "name": "@trybun/server",
  "version": "0.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --enable-source-maps dist/worker.js & node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate --generator client",
    "openapi": "vitest run src/platform/http/openapi.spec.ts --update"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/lib-storage": "^3.1160.0",
    "@casl/ability": "^7.0.2",
    "@casl/prisma": "^2.0.2",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@trybun/contracts": "workspace:*",
    "@trybun/i18n": "workspace:*",
    "@trybun/markdown": "workspace:*",
    "bullmq": "^6.4.2",
    "clamscan": "^2.4.0",
    "file-type": "^22.3.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "intl-messageformat": "^12.1.4",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "multer": "^2.5.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "uuid": "^14.0.3",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@rspack/core": "^2.2.9",
    "@standard-schema/spec": "^1.1.0",
    "@swc/core": "^1.16.20",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/valkey": "^12.2.1",
    "@trybun/eslint-config": "workspace:*",
    "@trybun/tsconfig": "workspace:*",
    "@types/clamscan": "^2.4.1",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/webpack-node-externals": "^3.0.4",
    "@types/yauzl": "^3.4.0",
    "eslint": "^10.13.0",
    "msw": "^3.0.3",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5",
    "webpack-node-externals": "^3.0.0"
  }
}
