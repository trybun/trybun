                            ]
                          },
                          "isDone": {
                            "type": "boolean"
                          },
                          "isOptional": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "id",
                          "isDone",
                          "isOptional"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Administration"
