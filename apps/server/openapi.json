{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/users/me": {
      "get": {
        "operationId": "UsersController_findCurrent",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "displayName": {
                      "nullable": true,
                      "type": "string"
                    },
                    "email": {
                      "nullable": true,
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "team",
                        "end_user"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "displayName",
                    "email",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/api/v1/users/me/product-tours": {
      "get": {
        "operationId": "UsersController_findProductTourProgress",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tourId": {
                            "type": "string",
                            "enum": [
                              "first_login"
                            ]
                          },
                          "tourVersion": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "completed",
                              "skipped"
                            ]
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          }
                        },
                        "required": [
                          "tourId",
                          "tourVersion",
                          "status",
                          "updatedAt"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/api/v1/users/me/product-tours/{tourId}": {
      "put": {
        "operationId": "UsersController_recordProductTourProgress",
        "parameters": [
          {
            "name": "tourId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                "first_login"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tourVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "skipped"
                    ]
                  }
                },
                "required": [
                  "tourVersion",
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tourId": {
                      "type": "string",
                      "enum": [
                        "first_login"
                      ]
                    },
                    "tourVersion": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "completed",
                        "skipped"
                      ]
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "tourId",
                    "tourVersion",
                    "status",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ]
      }
    }
  },
