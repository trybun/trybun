{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/users/me": {
      "get": {
        "operationId": "UsersController_findCurrent",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "displayName": {
                      "nullable": true,
                      "type": "string"
                    },
                    "email": {
                      "nullable": true,
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "team",
                        "end_user"
                      ]
                    },
                    "allowedActions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "open_administration"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "displayName",
                    "email",
                    "kind",
                    "allowedActions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/api/v1/users/me/product-tours": {
      "get": {
        "operationId": "UsersController_findProductTourProgress",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "tourId": {
                            "type": "string",
                            "enum": [
                              "first_login"
                            ]
                          },
                          "tourVersion": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 1000
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "completed",
                              "skipped"
                            ]
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                          }
                        },
                        "required": [
                          "tourId",
                          "tourVersion",
                          "status",
                          "updatedAt"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "nextCursor": {
                      "nullable": true,
                      "type": "string"
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/api/v1/users/me/product-tours/{tourId}": {
      "put": {
        "operationId": "UsersController_recordProductTourProgress",
        "parameters": [
          {
            "name": "tourId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string",
              "enum": [
                "first_login"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "tourVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "completed",
                      "skipped"
                    ]
                  }
                },
                "required": [
                  "tourVersion",
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tourId": {
                      "type": "string",
                      "enum": [
                        "first_login"
                      ]
                    },
                    "tourVersion": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "completed",
                        "skipped"
                      ]
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "tourId",
                    "tourVersion",
                    "status",
                    "updatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Users"
        ]
      }
    },
    "/api/v1/setup": {
      "get": {
        "operationId": "SetupController_find",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "available",
                        "completed"
                      ]
                    },
                    "defaultLanguage": {
                      "type": "string",
                      "enum": [
                        "en",
                        "pl"
                      ]
                    },
                    "defaultTimeZone": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "defaultLanguage",
                    "defaultTimeZone"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Setup"
        ]
      }
    },
    "/api/v1/setup/token-verification": {
      "post": {
        "operationId": "SetupController_verifyToken",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "required": [
                  "token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "available",
                        "completed"
                      ]
                    },
                    "defaultLanguage": {
                      "type": "string",
                      "enum": [
                        "en",
                        "pl"
                      ]
                    },
                    "defaultTimeZone": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "defaultLanguage",
                    "defaultTimeZone"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Setup"
        ]
      }
    },
    "/api/v1/setup/administrator": {
      "post": {
        "operationId": "SetupController_createAdministrator",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 15,
                    "maxLength": 64
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "en",
                      "pl"
                    ]
                  },
                  "timeZone": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "required": [
                  "token",
                  "firstName",
                  "lastName",
                  "email",
                  "password",
                  "language",
                  "timeZone"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "tags": [
          "Setup"
        ]
      }
    },
