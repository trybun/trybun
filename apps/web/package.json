{
  "name": "@trybun/web",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "eslint . && pnpm api:generate --check && node scripts/generate-help-content.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "postinstall": "prisma generate --schema ../server/prisma/schema.prisma --generator web",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "api:generate": "openapi-typescript ../server/openapi.json --output src/lib/api-client/schema.d.ts",
    "help:generate": "node scripts/generate-help-content.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.104.4",
    "@trybun/contracts": "workspace:*",
    "@trybun/i18n": "workspace:*",
    "@trybun/ui": "workspace:*",
    "client-only": "^0.0.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "minisearch": "^7.2.0",
    "next": "^16.4.2",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.9",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/env": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@trybun/eslint-config": "workspace:*",
    "@trybun/tsconfig": "workspace:*",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "lighthouse": "^13.5.0",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "prisma": "^7.10.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
