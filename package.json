{
  "name": "trybun",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && prettier --check .",
