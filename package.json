{
  "name": "trybun",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait && docker compose -f compose.yaml -f compose.dev.yaml wait keycloak-config && pnpm db:migrate && pnpm db:seed && turbo run dev",
    "lint": "turbo run lint && prettier --check . && node scripts/check-prisma.js && node scripts/check-supply-chain.js && shellcheck deploy/trybun docker/backup/backup.sh scripts/restore-test.sh",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --project scripts",
    "test:integration": "turbo run test:integration",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpm --filter @trybun/web e2e",
    "storybook": "pnpm --filter @trybun/ui storybook",
    "lint:spec": "node scripts/check-spec-references.js",
    "db:migrate": "pnpm --filter @trybun/server db:migrate",
    "db:seed": "pnpm --filter @trybun/server db:seed",
    "api:generate": "pnpm --filter @trybun/server openapi && pnpm --filter @trybun/web api:generate",
    "help:generate": "pnpm --filter @trybun/web help:generate"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "2.11.9",
    "vitest": "^5.0.5"
  },
  "version": "0.1.2"
}
