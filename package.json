{
  "name": "trybun",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait && docker compose -f compose.yaml -f compose.dev.yaml wait keycloak-config && turbo run dev",
    "lint": "turbo run lint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run --project scripts",
    "test:integration": "turbo run test:integration",
    "test:coverage": "vitest run --coverage",
    "lint:spec": "node scripts/check-spec-references.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@vitest/coverage-v8": "^5.0.4",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "vitest": "^5.0.4"
  }
}
