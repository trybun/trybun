#!/bin/sh
# Command of the Trybun deployment package (§15.4): installs Trybun and prints the setup link of
# the first-run wizard (§15.5, §15.6), backs it up, restores a backup, updates it to a new release
# and removes it from the server (§15.5, §15.7, §15.10). Needs only sh, awk, od, tar and Docker,
# and for updates curl or wget and sha256sum. Run `./trybun --help`.
set -eu

# Oldest versions that support every feature compose.yaml uses (health check `start_interval`).
# Raise them when compose.yaml needs a newer feature.
MIN_DOCKER_VERSION=25.0
MIN_COMPOSE_VERSION=2.20.2

# Total memory of the server (§15.2), in bytes: a server sold as "8 GB" reports a little less than
# 8 GiB but more than 8 × 10⁹ bytes.
MIN_MEMORY_BYTES=8000000000
RECOMMENDED_MEMORY_BYTES=16000000000

# Variables of .env.example generated as 32 random bytes in hex.
SECRETS='TRYBUN_POSTGRES_PASSWORD TRYBUN_KEYCLOAK_DB_PASSWORD TRYBUN_KEYCLOAK_ADMIN_PASSWORD
TRYBUN_VALKEY_PASSWORD TRYBUN_S3_ACCESS_KEY_ID TRYBUN_S3_SECRET_ACCESS_KEY AUTH_SECRET
TRYBUN_KEYCLOAK_WEB_CLIENT_SECRET TRYBUN_KEYCLOAK_SERVER_CLIENT_SECRET TRYBUN_BACKUP_PASSPHRASE'

# Where the releases are published; the tests replace it.
RELEASES=${TRYBUN_RELEASES_URL:-https://github.com/trybun/trybun/releases}

# Files of the deployment package, which `update` replaces and `restore` brings back; `.env` is
# never part of a package.
PACKAGE_FILES='compose.yaml .env.example INSTALL.md LICENSE CHANGELOG.md docker trybun'

# Paths read from the server; the tests replace them.
MEMINFO=${TRYBUN_MEMINFO:-/proc/meminfo}
ZONEINFO=${TRYBUN_ZONEINFO:-/usr/share/zoneinfo}
ETC=${TRYBUN_ETC:-/etc}

usage() {
  cat <<'EOF'
Usage: ./trybun <command>

Commands:
  install       Check the server, create .env with generated secrets, start Trybun and print
                the setup link. Safe to re-run: an existing .env is never changed.
  setup-token   Print a new setup link for the first-run wizard (valid for 24 hours, works once).
  backup        Back up both databases, the objects and the configuration now.
  backup list   List the backups on this server and on the external S3 storage.
  restore [<backup>] [--test [--storage-url <url>]] [--replace-foreign-objects]
                Replace all data and the configuration with a backup (default: the newest) and
                start the version it was taken with. Also restores onto a new server. Asks again
                before it replaces a storage folder of another Trybun server, or one with objects
                but without a Trybun marker; without a terminal it refuses, unless
                --replace-foreign-objects is given.
                --test marks a test restore while the backed-up server runs: it empties
                TRYBUN_BACKUP_S3_URL of .env, so the test server makes no off-site backups.
                --storage-url (with --test, required for attachments on an external storage)
                restores the attachments into another folder and sets TRYBUN_S3_URL of .env to it.
  update <version>
                Back up, then install and start the release <version>, e.g. 1.4.1.
  uninstall     Delete Trybun from this server: containers, all data, the backups on this server
                and the images. Keeps this folder with .env and the backups on the S3 storage.
  --help        Show this help.

Documentation: INSTALL.md
EOF
}

say() {
  printf '%s\n' "$*"
}

warn() {
  printf 'Warning: %s\n' "$*" >&2
}

# Prints what is wrong and how to fix it, and stops.
fail() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

# Asks a question; prints the answer, or the default for an empty answer.
ask() {
  printf '%s' "$1" >&2
  answer=
  if ! IFS= read -r answer; then
    printf '\n' >&2
    fail "No answer to \"$1\". Run ./trybun $COMMAND in a terminal and answer the questions. Nothing was changed."
  fi
  if [ -z "$answer" ]; then
    answer=${2-}
  fi
  printf '%s' "$answer"
}

# Succeeds when version $1 is at least version $2 (dotted numbers, an optional leading v).
version_at_least() {
  awk -v actual="$1" -v minimum="$2" 'BEGIN {
    sub(/^v/, "", actual)
    n = split(actual, a, "."); m = split(minimum, b, ".")
    for (i = 1; i <= (n > m ? n : m); i++) {
      x = a[i] + 0; y = b[i] + 0
      if (x != y) exit !(x > y)
    }
    exit 0
  }'
}

check_docker() {
  command -v docker >/dev/null 2>&1 ||
    fail "Docker is not installed. Install Docker Engine $MIN_DOCKER_VERSION or newer with the Docker Compose plugin (https://docs.docker.com/engine/install/) and run ./trybun $COMMAND again."
  docker_version=$(docker version --format '{{.Server.Version}}' 2>/dev/null) ||
    fail "Docker Engine is not running or this user may not use it. Start Docker (systemctl start docker), or run ./trybun as root or as a member of the group docker, and run ./trybun $COMMAND again."
  version_at_least "$docker_version" "$MIN_DOCKER_VERSION" ||
    fail "Docker Engine $docker_version is too old; Trybun needs $MIN_DOCKER_VERSION or newer. Update Docker Engine (https://docs.docker.com/engine/install/) and run ./trybun $COMMAND again."
  compose_version=$(docker compose version --short 2>/dev/null) ||
    fail "The Docker Compose plugin is not installed. Install it (https://docs.docker.com/compose/install/linux/) and run ./trybun $COMMAND again."
  version_at_least "$compose_version" "$MIN_COMPOSE_VERSION" ||
    fail "Docker Compose $compose_version is too old; Trybun needs $MIN_COMPOSE_VERSION or newer. Update the Docker Compose plugin (https://docs.docker.com/compose/install/linux/) and run ./trybun $COMMAND again."
}

check_memory() {
  [ -r "$MEMINFO" ] || fail "Cannot read $MEMINFO to check the memory of the server. Run ./trybun install on Linux."
  memory=$(awk '$1 == "MemTotal:" { printf "%.0f", $2 * 1024 }' "$MEMINFO")
  [ -n "$memory" ] || fail "$MEMINFO has no MemTotal line. Run ./trybun install on Linux."
  gigabytes=$(awk -v bytes="$memory" 'BEGIN { printf "%.1f", bytes / 1e9 }')
  if awk -v bytes="$memory" -v minimum="$MIN_MEMORY_BYTES" 'BEGIN { exit !(bytes < minimum) }'; then
    fail "The server has $gigabytes GB of memory; Trybun needs at least 8 GB. Run it on a server with 8 GB or more (16 GB recommended)."
  fi
  if awk -v bytes="$memory" -v recommended="$RECOMMENDED_MEMORY_BYTES" 'BEGIN { exit !(bytes < recommended) }'; then
    warn "The server has $gigabytes GB of memory; 16 GB are recommended. Trybun runs, but may be slow under load."
  fi
}

# Succeeds when the caddy container of this installation is running; its ports count as free.
own_caddy_running() {
  docker compose ps --status running --services 2>/dev/null | grep -qx caddy
}

check_ports() {
  command -v ss >/dev/null 2>&1 ||
    fail "The command ss is missing, so the ports cannot be checked. Install it (package iproute2) and run ./trybun install again."
  if own_caddy_running; then
    return
  fi
  taken=$( {
    ss -Hltn | awk '$4 ~ /:(80|443)$/ { sub(/.*:/, "", $4); print "TCP " $4 }'
    ss -Hlun | awk '$4 ~ /:443$/ { print "UDP 443" }'
  } | sort -u | tr '\n' ',' | sed 's/,$//; s/,/, /g')
  [ -z "$taken" ] ||
    fail "Port(s) $taken already in use. Trybun's reverse proxy needs TCP ports 80 and 443 and UDP port 443. Stop the program that uses them (see: sudo ss -ltnup) and run ./trybun install again."
}

check_prerequisites() {
  check_docker
  check_memory
  check_ports
}

# Domain name rules of the server (a host name: labels of letters, digits and hyphens).
valid_domain() {
  [ "${#1}" -le 253 ] &&
    printf '%s\n' "$1" | grep -Eqx '([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)*[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?'
}

# An IANA time zone name the server knows.
valid_time_zone() {
  case $1 in
    UTC) return 0 ;;
    '' | /* | *..* | *[!A-Za-z0-9_+/-]*) return 1 ;;
  esac
  [ ! -d "$ZONEINFO" ] || [ -f "$ZONEINFO/$1" ]
}

# The time zone of the server, else UTC.
server_time_zone() {
  zone=
  if [ -r "$ETC/timezone" ]; then
    zone=$(head -n 1 "$ETC/timezone")
  elif [ -L "$ETC/localtime" ]; then
    zone=$(readlink "$ETC/localtime" | sed -n 's|.*/zoneinfo/||p')
  fi
  if [ -n "$zone" ] && valid_time_zone "$zone"; then
    printf '%s' "$zone"
  else
    printf 'UTC'
  fi
}

ask_questions() {
  while :; do
    domain=$(ask 'Domain of Trybun, e.g. trybun.example.com: ' '')
    domain=$(printf '%s' "$domain" | tr '[:upper:]' '[:lower:]')
    valid_domain "$domain" && break
    say "\"$domain\" is not a domain name. Enter the name without https:// and without a path." >&2
  done
  while :; do
    language=$(ask 'Default language, en or pl [en]: ' en)
    case $language in en | pl) break ;; esac
    say "\"$language\" is not supported. Enter en or pl." >&2
  done
  default_zone=$(server_time_zone)
  while :; do
    time_zone=$(ask "Default time zone, an IANA name such as Europe/Warsaw [$default_zone]: " "$default_zone")
    valid_time_zone "$time_zone" && break
    say "\"$time_zone\" is not an IANA time zone. Enter a name such as Europe/Warsaw or UTC." >&2
  done
}

# Warns when the domain does not resolve to an address of this server; servers behind NAT or with
# a floating IP do not see their public address, so the Administrator may continue.
check_domain() {
  domain_addresses=$(getent ahosts "$domain" 2>/dev/null | awk '{ print $1 }' | sort -u) || domain_addresses=
  server_addresses=$( {
    ip -o addr show 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4 }'
    hostname -I 2>/dev/null | tr ' ' '\n'
  } | sort -u) || server_addresses=
  for address in $domain_addresses; do
    if printf '%s\n' "$server_addresses" | grep -qxF "$address"; then
      return
    fi
  done
  if [ -z "$domain_addresses" ]; then
    warn "$domain does not resolve to any address."
  else
    warn "$domain resolves to $(printf '%s' "$domain_addresses" | paste -sd ' ' -), not to an address of this server."
  fi
  say 'Caddy cannot obtain the HTTPS certificate until the domain points to this server. Behind NAT or a floating IP the server does not see its public address, and this warning can be ignored.' >&2
  confirmation=$(ask 'Continue anyway? [y/N]: ' n)
  case $confirmation in
    y | Y | yes | YES) ;;
    *) fail "Installation stopped. Point an A or AAAA record of $domain to this server and run ./trybun install again. Nothing was changed." ;;
  esac
}

random_secret() {
  od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
}

# Prints the backup passphrase once and waits for the Administrator to confirm it is stored.
confirm_passphrase() {
  say ''
  say 'Backup passphrase. It encrypts the backups; without it, off-site backups cannot be restored'
  say 'after the server is lost. Store it outside this server now, e.g. in a password manager:'
  say ''
  say "    $1"
  say ''
  while :; do
    confirmation=$(ask 'Type "stored" once the passphrase is stored outside this server: ' '')
    [ "$confirmation" = stored ] && break
  done
}

# Writes .env from .env.example with the answers and the generated secrets. The file appears
# complete or not at all, and an existing .env is never replaced.
write_env() {
  [ -r .env.example ] || fail ".env.example is missing. Run ./trybun from the unpacked deployment package."
  passphrase=
  for name in $SECRETS; do
    secret=$(random_secret)
    [ "$name" != TRYBUN_BACKUP_PASSPHRASE ] || passphrase=$secret
    export "TRYBUN_SECRET_$name=$secret"
  done
  confirm_passphrase "$passphrase"
  umask 077
  temporary=$(mktemp .env.XXXXXX)
  trap 'rm -f "$temporary"' EXIT
  trap 'exit 130' HUP INT TERM
  # Values pass through the environment, not the command line, which other users can see.
  TRYBUN_ANSWER_DOMAIN=$domain TRYBUN_ANSWER_LANGUAGE=$language TRYBUN_ANSWER_TIME_ZONE=$time_zone \
    awk -v secrets="$SECRETS" '
      BEGIN {
        n = split(secrets, names, /[ \n]+/)
        for (i = 1; i <= n; i++) if (names[i] != "") value[names[i]] = ENVIRON["TRYBUN_SECRET_" names[i]]
        value["TRYBUN_DOMAIN"] = ENVIRON["TRYBUN_ANSWER_DOMAIN"]
        value["TRYBUN_DEFAULT_LANGUAGE"] = ENVIRON["TRYBUN_ANSWER_LANGUAGE"]
        value["TRYBUN_DEFAULT_TIME_ZONE"] = ENVIRON["TRYBUN_ANSWER_TIME_ZONE"]
      }
      match($0, /^(# )?[A-Z_][A-Z0-9_]*=/) {
        name = substr($0, 1, RLENGTH - 1); sub(/^# /, "", name)
        if (name in value) { print name "=" value[name]; written[name] = 1; next }
      }
      { print }
      END { for (name in value) if (!(name in written)) { print name > "/dev/stderr"; missing = 1 }; exit missing + 0 }
    ' .env.example >"$temporary" ||
    fail ".env.example does not contain the variables listed above. Use the .env.example of the deployment package and run ./trybun install again. Nothing was changed."
  chmod 600 "$temporary"
  # ln never replaces an existing file.
  ln "$temporary" .env 2>/dev/null ||
    fail ".env was created by someone else meanwhile and was left unchanged. Run ./trybun install again."
  rm -f "$temporary"
  trap - EXIT HUP INT TERM
  say 'Created .env (readable only by its owner).'
}

setup_token() {
  docker compose exec -T api node dist/cli.js setup-token
}

# Exit code of setup-token once an Administrator exists (apps/server/src/modules/setup).
ALREADY_SET_UP=3

# The setup link at the end of the installation; a system that is already set up is complete.
print_setup_link() {
  status=0
  setup_token || status=$?
  [ "$status" -eq 0 ] || [ "$status" -eq "$ALREADY_SET_UP" ] || exit "$status"
}

# The Compose project of the installation: `name` of compose.yaml.
PROJECT=${COMPOSE_PROJECT_NAME:-trybun}

# A new .env cannot use the data of an earlier installation: PostgreSQL keeps the passwords the
# database was created with, so the database migrations would fail to sign in.
check_no_earlier_data() {
  volumes=$(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT" | tr '\n' ' ' | sed 's/ $//')
  [ -z "$volumes" ] ||
    fail "Data of an earlier installation of Trybun is on this server (Docker volumes: $volumes), but .env is missing, so its passwords are unknown. Copy the .env of that installation into this folder and run ./trybun install again. If the data is not needed, delete it (this cannot be undone): docker ps -aq --filter label=com.docker.compose.project=$PROJECT | xargs -r docker rm -f && docker volume rm $volumes, and run ./trybun install again. Nothing was changed."
}

install() {
  check_prerequisites
  if [ -e .env ]; then
    say '.env exists: keeping it unchanged, without questions and new secrets.'
  else
    check_no_earlier_data
    ask_questions
    check_domain
    write_env
  fi
  say 'Starting Trybun (docker compose up -d --wait). The first start downloads the images and takes a few minutes.'
  docker compose up -d --wait ||
    fail "Trybun did not start. See docker compose ps and docker compose logs <service>, fix the cause (often a setting in .env) and run ./trybun install again; .env is kept."
  print_setup_link
}

# --- Backups (§15.10) ---

# The value of a variable in .env.
env_value() {
  sed -n "s/^$1=//p" .env | tail -n 1
}

require_env() {
  [ -f .env ] ||
    fail ".env is missing. Run ./trybun in the folder of the installation. On a new server, copy the .env of the installation (kept outside the old server) into this folder and run ./trybun $COMMAND again."
}

# Runs a backup with the tag $1 and keeps the ID of its snapshot on this server in $snapshot.
run_backup() {
  say 'Backing up both databases, the objects and the configuration.'
  output=$(docker compose run --rm -T backup backup "$1") || return 1
  snapshot=$(printf '%s\n' "$output" | awk '$1 == "local" { print $2 }')
  [ -n "$snapshot" ] || return 1
  printf '%s\n' "$output" | while read -r repository id; do
    case $repository in
      local) say "Backup $id stored on this server." ;;
      s3) say "Backup $id stored on the external S3 storage." ;;
    esac
  done
}

backup() {
  require_env
  case ${1-} in
    '')
      check_docker
      run_backup manual ||
        fail 'The backup failed. See the messages above and docker compose logs backup.'
      ;;
    list) docker compose run --rm -T --no-deps backup list ;;
    *) fail "Unknown argument \"$1\". Use ./trybun backup or ./trybun backup list." ;;
  esac
}

# Replaces the file or folder $1 with the one in the folder $2.
replace() {
  if [ -d "$2/$1" ]; then
    rm -rf "$1.previous"
    [ ! -e "$1" ] || mv "$1" "$1.previous"
    mv "$2/$1" "$1"
    rm -rf "$1.previous"
  else
    # A rename: a running ./trybun keeps reading its own, old file.
    mv -f "$2/$1" "$1"
  fi
}

# awk function: the value the line of a .env assigns to the variable `name`, read as Docker Compose
# reads it, or SUBSEP when the line assigns no value to it. Leading blanks, `export `, blanks around
# `=` (or `:`) are allowed; a quoted value ends at its closing quote; an unquoted one at ` #`,
# without trailing blanks. Compose also expands `${…}`, which no storage URL contains.
ENV_VALUE='function env_value(line, name, rest, quote, end) {
  sub(/\r$/, "", line)
  sub(/^[ \t]+/, "", line)
  sub(/^export[ \t]+/, "", line)
  if (substr(line, 1, length(name)) != name) return SUBSEP
  rest = substr(line, length(name) + 1)
  if (rest !~ /^[ \t]*[=:]/) return SUBSEP
  sub(/^[ \t]*[=:][ \t]*/, "", rest)
  quote = substr(rest, 1, 1)
  if (quote == "\"" || quote == "\047") {
    rest = substr(rest, 2)
    end = index(rest, quote)
    return end ? substr(rest, 1, end - 1) : rest
  }
  end = index(rest, " #")
  if (end) rest = substr(rest, 1, end - 1)
  sub(/[ \t]+$/, "", rest)
  return rest
}'

# Brings back .env and the files of the deployment package of the fetched backup.
restore_configuration() {
  temporary=$(mktemp -d .restore.XXXXXX)
  trap 'rm -rf "$temporary"' EXIT
  trap 'exit 130' HUP INT TERM
  docker compose run --rm -T --no-deps backup configuration >"$temporary/configuration.tar" ||
    fail 'The configuration of the backup could not be read. Nothing was changed.'
  mkdir "$temporary/files"
  tar -xf "$temporary/configuration.tar" -C "$temporary/files"
  [ -f "$temporary/files/.env" ] || fail 'The backup contains no .env. Nothing was changed.'
  if [ -n "$test_restore" ]; then
    # --test: a test restore must not back up into the repository of the server it copies, whose
    # old snapshots its daily `forget` would prune (same host name), so TRYBUN_BACKUP_S3_URL is
    # emptied; without it the backup service makes no off-site backup (the credentials alone are
    # not used). --storage-url: the restored .env uses that folder instead of the backup's one.
    backup_s3_url=$(awk "$ENV_VALUE"'
      { value = env_value($0, "TRYBUN_BACKUP_S3_URL"); if (value != SUBSEP) url = value }
      END { printf "%s", url }
    ' "$temporary/files/.env")
    TRYBUN_RESTORE_STORAGE_URL=$target_storage_url awk "$ENV_VALUE"'
      BEGIN { url = ENVIRON["TRYBUN_RESTORE_STORAGE_URL"] }
      url != "" && env_value($0, "TRYBUN_S3_URL") != SUBSEP { if (!done) print "TRYBUN_S3_URL=" url; done = 1; next }
      env_value($0, "TRYBUN_BACKUP_S3_URL") != SUBSEP { print "TRYBUN_BACKUP_S3_URL="; next }
      { print }
      END { if (url != "" && !done) print "TRYBUN_S3_URL=" url }
    ' "$temporary/files/.env" >"$temporary/env"
    mv "$temporary/env" "$temporary/files/.env"
  fi
  chmod 600 "$temporary/files/.env"
  for name in $PACKAGE_FILES .env; do
    [ ! -e "$temporary/files/$name" ] || replace "$name" "$temporary/files"
  done
  rm -rf "$temporary"
  trap - EXIT HUP INT TERM
}

# A storage folder for --storage-url, as the server reads TRYBUN_S3_URL (§15.3): http(s) in any
# case, a bucket name of S3, an optional folder, no credentials, query or fragment, and no `.` or
# `..` segment (also percent-encoded), which the server would resolve. Only characters that need
# no quoting in .env. parse_storage_url of docker/backup/backup.sh applies the same rules.
valid_storage_url() {
  printf '%s\n' "$1" |
    grep -Eqx "[Hh][Tt][Tt][Pp]([Ss])?://(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9._-]+)(:[0-9]{1,5})?/[a-z0-9][a-z0-9.-]{1,61}[a-z0-9](/[A-Za-z0-9._~%+,:@=!-]*)*" ||
    return 1
  case $(printf '%s/\n' "${1#*://*/}" | sed 's/%2[Ee]/./g') in
    ./* | ../* | */./* | */../*) return 1 ;;
  esac
}

# The restore replaces the content of the storage folder of the backup's .env (TRYBUN_S3_URL), or
# of the folder of --storage-url, which must lie outside the backup's one; neither may overlap a
# backup repository. When the folder's marker names another Trybun server – e.g. production, when
# its backup is restored onto a test server with its .env – or the folder holds objects without a
# marker (Q26), it asks a second question, or refuses without a terminal, unless
# --replace-foreign-objects was given. A test restore of a backup on an external storage needs
# --storage-url (Q25). Sets $replace_objects for restore-data.
check_storage_folder() {
  owner=$(docker compose run --rm -T backup storage-owner ${test_restore:+--test} ${target_storage_url:+"$target_storage_url"}) ||
    fail "The storage folder of the backup $backup_id could not be read. See the messages above. Nothing was changed; start Trybun again with docker compose up -d --wait."
  storage_url=${owner#* }
  unchanged='Nothing was changed; start Trybun again with docker compose up -d --wait.'
  case ${owner%% *} in
    own | none) return 0 ;;
    foreign)
      problem="The storage folder $storage_url belongs to another Trybun server"
      question="The storage folder $storage_url belongs to another Trybun server. Replace its content? [y/N]: "
      ;;
    unmarked)
      problem="The storage folder $storage_url holds objects but no Trybun marker, so it may belong to another application or server"
      question="The storage folder $storage_url holds objects but no Trybun marker. Replace its content? [y/N]: "
      ;;
    overlap) fail "The folder $target_storage_url of --storage-url overlaps the storage folder $storage_url of the backup, which the restore leaves untouched. Name a folder outside it, e.g. another bucket. $unchanged" ;;
    repository) fail "The storage folder ${storage_url%% *} overlaps the backup repository ${storage_url#* } (TRYBUN_BACKUP_S3_URL), so the restore would delete backups. Keep the attachments and the backups in separate folders, e.g. separate buckets. $unchanged" ;;
    external) fail "The attachments of the backup are on the external storage $storage_url, which the backed-up installation may still use. Restore them into an empty folder for the test with --storage-url <url>, e.g. ./trybun restore $backup_id --test --storage-url https://s3.example.com/bucket-restore-test. $unchanged" ;;
    *) fail "Unexpected answer \"$owner\" about the storage folder of the backup $backup_id. $unchanged" ;;
  esac
  replace_objects=--replace-foreign-objects
  [ -z "$replace_foreign_objects" ] || return 0
  if [ ! -t 0 ]; then
    hint=
    [ -n "$test_restore" ] ||
      hint=' To test a restore while that server runs, add --test (and --storage-url <url> for an external storage).'
    fail "$problem; the restore would replace its content. Run ./trybun restore $backup_id in a terminal to confirm, or add --replace-foreign-objects.$hint $unchanged"
  fi
  confirmation=$(ask "$question" n)
  case $confirmation in
    y | Y | yes | YES) ;;
    *) fail "Restore stopped. $unchanged" ;;
  esac
}

# Sets the passwords of the database users to those of .env, also when the database volume was
# created with other ones (§15.5): over the local socket of the container, through stdin.
set_database_passwords() {
  postgres_password=$(env_value TRYBUN_POSTGRES_PASSWORD | sed "s/'/''/g")
  keycloak_password=$(env_value TRYBUN_KEYCLOAK_DB_PASSWORD | sed "s/'/''/g")
  printf "ALTER ROLE trybun PASSWORD '%s';\nALTER ROLE keycloak PASSWORD '%s';\n" \
    "$postgres_password" "$keycloak_password" |
    docker compose exec -T postgres psql --username=trybun --dbname=postgres --quiet --set=ON_ERROR_STOP=1
}

restore() {
  backup_id=
  replace_foreign_objects=
  replace_objects=
  target_storage_url=
  storage_url_given=
  test_restore=
  backup_s3_url=
  while [ "$#" -gt 0 ]; do
    argument=$1
    shift
    case $argument in
      --replace-foreign-objects) replace_foreign_objects=1 ;;
      --test) test_restore=1 ;;
      --storage-url | --storage-url=*)
        [ -z "$storage_url_given" ] || fail 'Name one folder with --storage-url, not two.'
        storage_url_given=1
        if [ "$argument" = --storage-url ]; then
          [ "$#" -gt 0 ] || fail 'Name the folder after --storage-url, e.g. --storage-url https://s3.example.com/bucket/trybun-test.'
          target_storage_url=$1
          shift
        else
          target_storage_url=${argument#--storage-url=}
        fi
        valid_storage_url "$target_storage_url" ||
          fail "\"$target_storage_url\" is not the URL of a storage folder. Name http:// or https://, the address of the storage, a bucket and an optional folder, without credentials, query or fragment, e.g. --storage-url https://s3.example.com/bucket/trybun-test."
        ;;
      -*) fail "Unknown option \"$argument\". Use ./trybun restore [<backup>] [--test [--storage-url <url>]] [--replace-foreign-objects]." ;;
      *)
        [ -z "$backup_id" ] || fail "Name one backup, not \"$backup_id\" and \"$argument\"."
        backup_id=$argument
        ;;
    esac
  done
  # A restore into another folder copies a server that still runs: always a test restore (Q25).
  [ -z "$target_storage_url" ] || [ -n "$test_restore" ] ||
    fail 'A restore into another folder is a test restore: add --test, e.g. ./trybun restore --test --storage-url <url>.'
  backup_id=${backup_id:-latest}
  printf '%s\n' "$backup_id" | grep -Eqx 'latest|[0-9a-f]{8,64}' ||
    fail "\"$backup_id\" is not a backup. Name the ID of a backup listed by ./trybun backup list, or nothing for the newest one."
  require_env
  check_docker
  say "This replaces all data and the configuration of Trybun with the backup $backup_id and starts the version it was taken with."
  [ -z "$test_restore" ] ||
    say 'A test restore: the restored .env gets no TRYBUN_BACKUP_S3_URL, so the backups of the backed-up server stay untouched.'
  [ -z "$target_storage_url" ] ||
    say "The attachments are restored into $target_storage_url, which replaces TRYBUN_S3_URL of the backup's .env; the storage folder of the backup stays unchanged."
  confirmation=$(ask 'Continue? [y/N]: ' n)
  case $confirmation in
    y | Y | yes | YES) ;;
    *) fail 'Restore stopped. Nothing was changed.' ;;
  esac
  say 'Stopping Trybun.'
  docker compose stop
  docker compose run --rm -T --no-deps backup fetch "$backup_id" ||
    fail "The backup $backup_id could not be read. Nothing was changed; start Trybun again with docker compose up -d --wait."
  check_storage_folder
  restore_configuration
  say 'Restoring both databases and the objects.'
  { docker compose up -d --wait postgres && set_database_passwords &&
    docker compose run --rm -T backup restore-data ${replace_objects:+"$replace_objects"}; } ||
    fail "Restoring the data failed. See the messages above, fix the cause and run ./trybun restore $backup_id again."
  say 'Starting Trybun (docker compose up -d --wait).'
  docker compose up -d --wait ||
    fail 'Trybun did not start after the restore. See docker compose ps and docker compose logs <service>.'
  say "Restored the backup $backup_id."
  [ -z "$target_storage_url" ] || say "The attachments are in $target_storage_url (TRYBUN_S3_URL of .env)."
  [ -z "$backup_s3_url" ] ||
    say "TRYBUN_BACKUP_S3_URL of .env was emptied, so this test server makes no backups on the external S3 storage and leaves the backups of $backup_s3_url untouched. To back it up off-site, set TRYBUN_BACKUP_S3_URL to a repository of its own, not that one."
}

# --- Updates (§15.7) ---

# awk function: a sort key of a version X.Y.Z or X.Y.Z-rc.N; a release sorts after its release
# candidates.
VERSION_KEY='function version_key(v, parts, core, n) {
  n = split(v, parts, "-rc.")
  split(parts[1], core, ".")
  return sprintf("%09d%09d%09d%09d", core[1], core[2], core[3], n > 1 ? parts[2] : 999999999)
}'

# Prints -1, 0 or 1 when version $1 is lower than, equal to or higher than version $2.
compare_versions() {
  awk -v a="$1" -v b="$2" "$VERSION_KEY"'
    BEGIN { x = version_key(a); y = version_key(b); print (x < y ? -1 : x > y ? 1 : 0) }'
}

valid_version() {
  printf '%s\n' "$1" | grep -Eqx '(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-rc\.[1-9][0-9]*)?'
}

# The version of this deployment package: the default of TRYBUN_VERSION in compose.yaml.
installed_version() {
  sed -n 's/^ *image: ghcr\.io\/trybun\/server:[$]{TRYBUN_VERSION:-\([^}]*\)}$/\1/p' compose.yaml | head -n 1
}

download() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    fail 'Neither curl nor wget is installed. Install one of them and run ./trybun update again.'
  fi
}

# Prints the entries of the changelog $1 newer than version $2, up to version $3.
show_changes() {
  [ -f "$1" ] || return 0
  awk -v current="$(compare_key "$2")" -v target="$(compare_key "$3")" "$VERSION_KEY"'
    /^##? \[?[0-9]+\.[0-9]+\.[0-9]+/ {
      version = $2
      gsub(/[][]|\(.*/, "", version)
      key = version_key(version)
      show = key > current && key <= target
    }
    show { print }
  ' "$1"
}

compare_key() {
  awk -v v="$1" "$VERSION_KEY"' BEGIN { print version_key(v) }'
}

# Pulls the images of the enabled services of the compose file $1 that are not on the server yet,
# before anything changes; the images of a release never change.
pull_images() {
  images=$(docker compose -f "$1" --project-directory . config --images | sort -u) || return 1
  for image in $images; do
    docker image inspect "$image" >/dev/null 2>&1 || docker pull --quiet "$image" >/dev/null || return 1
  done
}

update() {
  target=${1-}
  [ -n "$target" ] ||
    fail "Name the version to update to, e.g. ./trybun update 1.4.1. The releases and their notes: $RELEASES"
  valid_version "$target" || fail "\"$target\" is not a version such as 1.4.1 or 1.5.0-rc.1."
  require_env
  current=$(installed_version)
  valid_version "$current" ||
    fail 'This folder is not the deployment package of a release, so it cannot be updated.'
  ! grep -q '^TRYBUN_VERSION=' .env ||
    fail "TRYBUN_VERSION is set in .env and would keep the old images. Remove the line and run ./trybun update $target again."
  case $(compare_versions "$target" "$current") in
    0)
      say "Trybun $current is already installed."
      return
      ;;
    -1) fail "$target is older than the installed $current. To return to an earlier version, restore the backup taken before the update to the current one: ./trybun restore <backup> (see ./trybun backup list)." ;;
  esac
  check_docker
  command -v sha256sum >/dev/null 2>&1 ||
    fail 'The command sha256sum is missing (package coreutils). Install it and run ./trybun update again.'

  temporary=$(mktemp -d .update.XXXXXX)
  trap 'rm -rf "$temporary"' EXIT
  trap 'exit 130' HUP INT TERM
  archive=trybun-$target.tar.gz
  say "Downloading Trybun $target."
  { download "$RELEASES/download/v$target/$archive" "$temporary/$archive" &&
    download "$RELEASES/download/v$target/SHA256SUMS" "$temporary/SHA256SUMS"; } ||
    fail "Trybun $target could not be downloaded from $RELEASES. Check the version and the connection. Nothing was changed."
  { grep -q " $archive\$" "$temporary/SHA256SUMS" &&
    (cd "$temporary" && sha256sum --check --ignore-missing --status SHA256SUMS); } ||
    fail "The download of Trybun $target does not match its checksum in SHA256SUMS. Nothing was changed."
  tar -xzf "$temporary/$archive" -C "$temporary"
  package=$temporary/trybun-$target
  for name in compose.yaml trybun; do
    [ -f "$package/$name" ] || fail "The archive of Trybun $target has no $name. Nothing was changed."
  done

  say ''
  say "Changes from $current to $target (release notes: $RELEASES/tag/v$target):"
  show_changes "$package/CHANGELOG.md" "$current" "$target"
  say ''
  if [ "${current%%.*}" != "${target%%.*}" ]; then
    say "$target is a new MAJOR version. Read its breaking changes and manual steps above first."
    confirmation=$(ask "Update from $current to $target? [y/N]: " n)
    case $confirmation in
      y | Y | yes | YES) ;;
      *) fail 'Update stopped. Nothing was changed.' ;;
    esac
  fi

  say "Pulling the images of Trybun $target."
  pull_images "$package/compose.yaml" ||
    fail "The images of Trybun $target could not be pulled. Check the connection and run ./trybun update $target again. Nothing was changed."
  run_backup pre-update ||
    fail 'The backup before the update failed, so nothing was changed. See the messages above and docker compose logs backup.'
  for name in $PACKAGE_FILES; do
    [ ! -e "$package/$name" ] || replace "$name" "$package"
  done
  say "Starting Trybun $target: migrating the databases and applying the sign-in configuration."
  docker compose up -d --wait --remove-orphans ||
    fail "The update to $target failed. To return to version $current with the data from before the update, run: ./trybun restore $snapshot"
  say "Updated Trybun from $current to $target. The backup from before the update is $snapshot."
}

# --- Uninstall (§15.5) ---

# The containers, volumes or networks ($1: ps, volume, network) of the Compose project.
project_objects() {
  case $1 in
    ps) docker ps -aq --filter "label=com.docker.compose.project=$project" ;;
    *) docker "$1" ls -q --filter "label=com.docker.compose.project=$project" ;;
  esac
}

# The images of the services and of the containers of the installation that are on this server.
installed_images() {
  {
    docker compose config --images
    for container in $containers; do
      docker inspect --format '{{.Config.Image}}' "$container"
    done
  } | sort -u | while read -r image; do
    if docker image inspect "$image" >/dev/null 2>&1; then
      printf '%s\n' "$image"
    fi
  done
}

uninstall() {
  require_env
  check_docker
  domain=$(env_value TRYBUN_DOMAIN)
  project=$(env_value COMPOSE_PROJECT_NAME)
  project=${project:-$PROJECT}
  containers=$(project_objects ps)
  volumes=$(project_objects volume)
  images=$(installed_images)
  if [ -z "$containers$volumes$images" ]; then
    say 'Trybun is not installed on this server: no containers, data or images of it are left. Nothing was changed.'
    return
  fi

  say "This deletes Trybun ($domain) from this server: the containers, both databases, the stored"
  say 'files, the backups on this server and the images. This folder with .env stays.'
  s3_url=$(env_value TRYBUN_BACKUP_S3_URL)
  if [ -n "$s3_url" ]; then
    say 'A last backup is stored on the external S3 storage first; the backups there stay.'
  else
    warn 'No external S3 storage is configured (TRYBUN_BACKUP_S3_URL), so no backup of Trybun will remain anywhere: the backups on this server are deleted too.'
  fi
  confirmation=$(ask "Type the domain of this installation ($domain) to delete Trybun from this server: " '')
  if [ -z "$domain" ] || [ "$confirmation" != "$domain" ]; then
    fail 'Uninstall stopped. Nothing was changed.'
  fi

  if [ -n "$s3_url" ] && [ -n "$volumes" ]; then
    run_backup uninstall ||
      fail 'The last backup failed, so nothing was deleted. See the messages above and docker compose logs backup.'
  fi

  say 'Deleting the containers, networks and data of Trybun.'
  docker compose down --volumes --remove-orphans ||
    fail 'Trybun could not be deleted completely. See the messages above, fix the cause and run ./trybun uninstall again.'
  # Also the containers, volumes and networks of services whose profile is off.
  { project_objects ps | xargs -r docker rm -f >/dev/null &&
    project_objects volume | xargs -r docker volume rm >/dev/null &&
    project_objects network | xargs -r docker network rm >/dev/null; } ||
    fail 'Trybun could not be deleted completely. See the messages above, fix the cause and run ./trybun uninstall again.'
  say 'Deleting the images of Trybun.'
  for image in $images; do
    docker image rm "$image" >/dev/null 2>&1 ||
      warn "Kept the image $image: another container on this server uses it."
  done

  say ''
  say 'Trybun is deleted from this server.'
  if [ -n "$s3_url" ]; then
    say 'To restore it, on this or a new server: unpack the deployment package of any release, copy'
    say 'this .env into its folder and run ./trybun restore; the backup comes from the S3 storage.'
  fi
  say 'Keep .env and the backup passphrase outside this server, then delete this folder with:'
  say "    rm -rf '$(pwd)'"
}

cd "$(dirname -- "$0")"
COMMAND=${1-}

case $COMMAND in
  install) install ;;
  setup-token) setup_token ;;
  backup) backup "${2-}" ;;
  restore)
    shift
    restore "$@"
    ;;
  update) update "${2-}" ;;
  uninstall) uninstall ;;
  '' | -h | --help | help) usage ;;
  *)
    usage >&2
    fail "Unknown command \"$1\". Use one of the commands above."
    ;;
esac
